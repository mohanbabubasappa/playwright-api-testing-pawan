# ================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ================================================

# No Auth - Public APIs
NO_AUTH_BASE_URL=https://jsonplaceholder.typicode.com

# Basic Auth
BASIC_AUTH_URL=https://httpbin.org
BASIC_AUTH_USERNAME=user
BASIC_AUTH_PASSWORD=passwd

# API Key Authentication
API_KEY_BASE_URL=https://httpbin.org
API_KEY=your_api_key_here
WEATHER_API_KEY=your_actual_openweathermap_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# Bearer Token / JWT
JWT_BASE_URL=https://httpbin.org
JWT_TOKEN=your_jwt_token_here
JWT_EXPIRED_TOKEN=your_expired_jwt_token_here

# OAuth 2.0
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=https://yourapp.com/callback
OAUTH_AUTH_URL=https://oauth-provider.com/authorize
OAUTH_TOKEN_URL=https://oauth-provider.com/token
OAUTH_SCOPE=read write

# Restful Booker API
RESTFUL_BOOKER_URL=https://restful-booker.herokuapp.com

# Test Data Directory
TEST_DATA_DIR=test_data
